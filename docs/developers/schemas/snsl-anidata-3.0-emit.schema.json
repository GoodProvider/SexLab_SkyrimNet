{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skyrimnet-sexlab.local/schemas/snsl-anidata-3.0-emit.json",
  "title": "SkyrimNet_SexLab animation data 3.0 (emit profile)",
  "description": "Complete generated file. Stricter than accept. Actor-count, consecutive stages, and full 2(n-1) transitions belong to the application.",
  "type": "object",
  "required": [
    "version",
    "creator",
    "orgasm_expected",
    "speaking_modifiers",
    "clothed"
  ],
  "propertyNames": {
    "pattern": "^(version|creator|orgasm_expected|speaking_modifiers|clothed|tags|transitions|stage [1-9][0-9]*)$"
  },
  "properties": {
    "version": {
      "const": "3.0"
    },
    "creator": {
      "type": "string",
      "minLength": 1
    },
    "orgasm_expected": {
      "$ref": "#/$defs/binary_actor_array"
    },
    "speaking_modifiers": {
      "$ref": "#/$defs/speaking_modifiers"
    },
    "clothed": {
      "$ref": "#/$defs/binary_actor_array"
    },
    "tags": {
      "$ref": "#/$defs/tags"
    },
    "transitions": {
      "$ref": "#/$defs/transitions"
    }
  },
  "patternProperties": {
    "^stage [1-9][0-9]*$": {
      "$ref": "#/$defs/stage"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "speaking_token": {
      "type": "string",
      "enum": ["_pleasure_", "_pain_", "_gagged_", "_kissing_"]
    },
    "binary_actor_array": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "enum": [0, 1]
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[^A-Z]*$"
      }
    },
    "actor_token_list": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/speaking_token"
      },
      "not": {
        "allOf": [
          {
            "contains": {
              "const": "_kissing_"
            }
          },
          {
            "anyOf": [
              {
                "contains": {
                  "const": "_pleasure_"
                }
              },
              {
                "contains": {
                  "const": "_pain_"
                }
              }
            ]
          }
        ]
      }
    },
    "speaking_modifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actor_token_list"
      }
    },
    "stage": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "speaking_modifiers": {
          "$ref": "#/$defs/speaking_modifiers"
        },
        "clothed": {
          "$ref": "#/$defs/binary_actor_array"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        }
      },
      "additionalProperties": false
    },
    "transitions": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": {
        "pattern": "^[1-9][0-9]*-[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
