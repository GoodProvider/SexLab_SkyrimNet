{% if not isTimePaused %}
     {% set sexlab = sexlab_get_threads(npc.UUID) -%}
     {% set sexlab.source = "sexlab_get_threads" %} 
     {% if not sexlab.threads %}
          {% set sexlab = read_json("SkyrimNet_SexLab/threads.json") %} 
          {% set sexlab.source = "file" %} 
     {% endif %}
{% else %} 
     {% set sexlab = read_json("SkyrimNet_SexLab/threads.json") %} 
     {% set sexlab.source = "file" %}
{% endif %}
{% if not sexlab.actors %} 
     {% set sexlab.actors = {} %} 
{% endif %} 
{% if existsIn(sexlab.actors, npc.name) %} 
     {% set speaker = at(sexlab.actors,npc.name) %} 
{% else %} 
     {% set speaker = {"speaking_modifiers":[], "victim":false, "notice_level":"nothing", "arousal":0} %}
{% endif %}
{% if is_narration_enabled() %}
{% if speaker.notice_level == "active" %}
   {% if contains(speaker.speaking_modifiers,"pleasure") or contains(speaker.speaking_modifiers, "pain") %} 
Include a strong emotional and physical narration with each response.
   {% endif %} 
{% else if speaker.arousal > 99 %}
You mind is awash in hormones and neurotransmitters, a painful itch that only sexual release will scratch.
{% else if speaker.arousal > 95 %}
You mind is awash in hormones and neurotransmitters, your mind is filled with sexual fantasies.
{% else if speaker.arousal > 90 %}
You mind is awash in hormones and neurotransmitters, your mind keeps turn towards sexual fantasies.
{% endif %}
{% endif %}